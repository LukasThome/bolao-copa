generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── NextAuth required models ──────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  accounts      Account[]
  sessions      Session[]
  palpites      Palpite[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Domain ────────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum FaseJogo {
  GRUPOS
  OITAVAS
  QUARTAS
  SEMIFINAL
  TERCEIRO_LUGAR
  FINAL
}

model Jogo {
  id           String    @id @default(cuid())
  timeCasa     String
  timeVisita   String
  dataHora     DateTime
  fase         FaseJogo  @default(GRUPOS)
  grupo        String? // "A", "B", etc. — null para fase eliminatória
  placarCasa   Int? // null = resultado ainda não lançado
  placarVisita Int?
  palpites     Palpite[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Palpite {
  id           String   @id @default(cuid())
  userId       String
  jogoId       String
  placarCasa   Int
  placarVisita Int
  pontos       Int? // null = resultado não calculado ainda
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jogo         Jogo     @relation(fields: [jogoId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, jogoId]) // um palpite por usuário por jogo
}
